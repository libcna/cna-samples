{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (EasyGL / OpenGL ES 3)",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":       "Debug",
        "CNA_GRAPHICS_RENDERER":  "OPENGLES3"
      }
    },
    {
      "name": "release",
      "displayName": "Release (EasyGL / OpenGL ES 3)",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":       "Release",
        "CNA_GRAPHICS_RENDERER":  "OPENGLES3"
      }
    },
    {
      "name": "web",
      "displayName": "Emscripten (WebAssembly)",
      "description": "Requires EMSDK active. Run: emcmake cmake --preset web",
      "binaryDir": "${sourceDir}/cmake-build-web",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":       "Release",
        "CNA_GRAPHICS_RENDERER":  "WEBGL2",
        "EASYGL_BUILD_EXAMPLES": "OFF",
        "EASYGL_BUILD_TESTS":    "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build all samples (EasyGL / OpenGL ES 3 debug)",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Build all samples (EasyGL / OpenGL ES 3 release)",
      "configurePreset": "release"
    },
    {
      "name": "web",
      "displayName": "Build all samples (EasyGL / WebGL 2 release)",
      "configurePreset": "web"
    }
  ]
}
